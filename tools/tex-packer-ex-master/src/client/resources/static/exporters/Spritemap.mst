{
  "ATLAS": {
    "SPRITES": [
      {{#rects}}
      {
        "SPRITE": {
          "name": "{{{name}}}",
          "x": {{frame.x}},
          "y": {{frame.y}},
          "w": {{frame.w}},
          "h": {{frame.h}},
          "offX": {{spriteSourceSize.x}},
          "offY": {{spriteSourceSize.y}},
          "sourceW": {{sourceSize.w}},
          "sourceH": {{sourceSize.h}}
        }
      }{{^last}},{{/last}}
      {{/rects}}
    ]
  },
  "meta": {
    "image": "{{{config.imageFile}}}",
    "size": {
      "w": {{config.imageWidth}},
      "h": {{config.imageHeight}}
    },
    "format": "RGBA8888",
    "resolution": "1"
  }
}
